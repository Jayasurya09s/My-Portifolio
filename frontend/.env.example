# Frontend API
# Local: http://localhost:8000 (or leave empty to use Vite proxy for /api)
# Prod: set to your backend URL (e.g. https://my-portifolio-i7in.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Backend (Python) AI chatbot via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
